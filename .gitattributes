# 统一换行符处理，避免 Windows / Mac 互相踩改
* text=auto

# 文本文件
*.cs text diff=csharp
*.shader text
*.md text
*.json text
*.yaml text
*.yml text
*.meta text
# Unity 资源在 Force Text 模式下是 YAML 文本，可正常查看差异
*.unity text
*.prefab text
*.asset text
*.mat text
*.controller text
*.playable text

# 二进制文件（不参与 diff / 合并）
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.blend binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.dll binary
*.aif binary
