# 统一换行符处理，避免 Windows / Mac 互相踩改
* text=auto

# 文本文件
*.cs text diff=csharp
*.shader text
*.md text
*.json text
*.yaml text
*.yml text
*.meta text
# Unity 资源通常是 YAML，但 TerrainData 等 .asset 仍是二进制。
# text=auto 可保留 YAML 的文本处理，同时避免全新检出时损坏二进制资源。
*.unity text
*.prefab text
*.asset text=auto
*.mat text
*.controller text
*.playable text

# 二进制文件（不参与 diff / 合并）
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.exr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.glb binary
*.blend binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.dll binary
*.aif binary
