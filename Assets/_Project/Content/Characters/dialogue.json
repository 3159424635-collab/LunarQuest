  "notes": [
    "人物姓名、外观建议与台词为原创草案，角色职责与主流程依据用户提供的流程设计。",
    "这是游戏端接入数据，不是已经运行的任务系统。语音、口型与科普视频不包含在本包中。",
    "节点条件使用结构化字段，禁止将字符串作为代码执行。"
  ],
  "runtime_contract": {
    "selection": "普通事件按 event 筛选节点，再对 conditions 全部求值，按 priority 从高到低取第一个。choice_continuation 节点只能由选项的 next_node 直接指定，不参与普通事件搜索；跳转前再次校验其 conditions。对话进行中不接受同一 NPC 的重复启动。",
    "condition_fields": ["field", "operator", "value"],
    "operators": ["eq", "lt", "gte"],
    "effects": "选项效果仅在玩家确认选项时执行；节点完成效果在字幕或演出结束后执行。所有效果均应由游戏端做幂等检查。",
    "state": {
      "sample_task_accepted": false,
      "sample_count": 0,
      "sample_delivered": false,
      "exhibit_complete": false,
      "collected_point_ids": []
    },
    "sample_rules": {
      "required_count": 3,
      "unique_point_ids": ["crater03_sample_a", "crater03_sample_b", "crater03_sample_c"],
      "success": "仅在任务已接取、交付尚未完成且当前点不在 collected_point_ids 时原子记录点 ID 并将 sample_count 加一，最大为三。",
      "animation": "采样有效且按住 E 时，玩家播放 sample 循环；进度完成或取消后回到 idle。样本封存字幕在计数事务成功后触发 sample_committed。",
      "cancel": "松开 E 停止 sample 动画；是否保留进度由游戏端统一配置，取消不增加 sample_count。",
      "delivery": "交付前再次校验 sample_task_accepted 为 true、sample_count 至少为三且 sample_delivered 为 false；在同一事务中设置 sample_count 为零与 sample_delivered 为 true。"
    }
  },
  "tasks": [
